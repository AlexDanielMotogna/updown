#!/bin/sh
#
# Blocks a commit that stages a secret.
#
# This is a public repository: anything committed here is published the moment
# it is pushed, and rewriting history does not un-publish it. So the cheap
# check runs before the commit exists, not after.
#
# Two layers, on purpose:
#
#   1. A dependency-free scan for the highest-risk shapes. This ALWAYS runs and
#      always blocks. No install required.
#   2. gitleaks, for the full ruleset in .gitleaks.toml. Runs only if the
#      binary is present; warns loudly when it is not, but does not block on
#      its absence, because a hook that refuses to let you commit until you
#      install something is a hook that gets deleted. CI is the hard gate.
#
# Escape hatch (use it and you own the consequences):
#   SKIP_SECRET_SCAN=1 git commit ...
#
# Enable in a fresh clone:  git config core.hooksPath .githooks
# (`pnpm install` does this for you via the `prepare` script.)

set -e

if [ "$SKIP_SECRET_SCAN" = "1" ]; then
  echo "pre-commit: secret scan SKIPPED by SKIP_SECRET_SCAN=1"
  exit 0
fi

RED=''
YELLOW=''
RESET=''
if [ -t 2 ]; then
  RED='\033[31m'
  YELLOW='\033[33m'
  RESET='\033[0m'
fi

fail() {
  printf "\n${RED}COMMIT BLOCKED — %s${RESET}\n\n" "$1" >&2
}

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

# ── Layer 1a: filenames that must never be committed ────────────────────────
# .gitignore already covers these, but a `git add -f` or a rule that gets
# edited later shouldn't be the only thing standing between us and a wallet.
BAD_NAMES=$(printf '%s\n' "$STAGED" | grep -E '(^|/)(id|authority|wallet|treasury|secrets|keypair)\.json$|(^|/)\.env($|\.)|(^|/)\.pgpass$|(^|/)\.npmrc$|-keypair\.json$|-authority\.json$|\.pem$' || true)
if [ -n "$BAD_NAMES" ]; then
  fail "these staged files hold credentials by convention:"
  printf '%s\n' "$BAD_NAMES" >&2
  printf "\nIf one of them is genuinely a placeholder, rename it or use SKIP_SECRET_SCAN=1.\n" >&2
  exit 1
fi

# ── Layer 1b: paths held back from version control by policy ────────────────
# Internal working notes that are deliberately not published. Kept here rather
# than in .gitignore so the exclusion is enforced even in a fresh clone where
# local git config has not been applied yet.
EXCLUDED=$(printf '%s\n' "$STAGED" | grep -E '^docs/security/' || true)
if [ -n "$EXCLUDED" ]; then
  fail "staged files under a path this project does not publish:"
  printf '%s\n' "$EXCLUDED" >&2
  exit 1
fi

# ── Layer 1c: content ───────────────────────────────────────────────────────
# A serialised keypair is an array of integers in a source file. No filename
# rule can ever catch that, which is the whole reason this layer exists.
ADDED=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++' || true)

if printf '%s' "$ADDED" | grep -Eq '\[[[:space:]]*[0-9]{1,3}([[:space:]]*,[[:space:]]*[0-9]{1,3}){31,}'; then
  fail "a staged line contains an array of 32+ small integers — that is what a serialised Ed25519/Solana secret key looks like."
  printf '%s' "$ADDED" | grep -En '\[[[:space:]]*[0-9]{1,3}([[:space:]]*,[[:space:]]*[0-9]{1,3}){31,}' | cut -c1-120 >&2
  exit 1
fi

if printf '%s' "$ADDED" | grep -Eq 'postgres(ql)?://[^:@[:space:]]+:[^@[:space:]]{6,}@'; then
  fail "a staged line contains a Postgres URL with a password in it."
  exit 1
fi

if printf '%s' "$ADDED" | grep -Eq 'sk-ant-(api|admin)[0-9]{2}-[A-Za-z0-9_-]{80,}'; then
  fail "a staged line contains an Anthropic API key."
  exit 1
fi

# ── Layer 2: gitleaks, full ruleset ─────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --config .gitleaks.toml --no-banner; then
    fail "gitleaks found a secret in the staged changes (values redacted above)."
    printf "Fix the finding, or add a narrow allowlist entry to .gitleaks.toml if it is a false positive.\n" >&2
    exit 1
  fi
else
  printf "${YELLOW}pre-commit: gitleaks not installed — only the built-in checks ran.${RESET}\n" >&2
  printf "${YELLOW}  Install it so the full ruleset runs locally instead of failing in CI:${RESET}\n" >&2
  printf "${YELLOW}    Windows:  winget install gitleaks     (or: scoop install gitleaks)${RESET}\n" >&2
  printf "${YELLOW}    macOS:    brew install gitleaks${RESET}\n" >&2
  printf "${YELLOW}    Linux:    https://github.com/gitleaks/gitleaks/releases${RESET}\n" >&2
fi

exit 0
